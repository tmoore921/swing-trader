# Copy to .env and fill in values

# Twelve Data API key — free tier at https://twelvedata.com (800 req/day, 8/min)
# Used for all price/OHLCV data (SPY, QQQ, VIX, candidate tickers).
TWELVEDATA_API_KEY=your_key_here

# Optional: seconds between API calls to stay under the 8 req/min free limit
TWELVEDATA_MIN_INTERVAL=8

# Optional: override account size if it changes
ACCOUNT_SIZE=500
